{
  "manifest_version": 3,
  "name": "Proz Secretaria",
  "version": "1.0.0",
  "description": "Ferramentas da secretaria: fechamento mensal de boletins. Os arquivos são lidos só neste computador.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "clipboardWrite"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Abrir painel da secretaria",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "side_panel": { "default_path": "panel/index.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
