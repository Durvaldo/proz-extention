  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/chrome": "0.3.7",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
